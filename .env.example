# Cloudflare — шаблон переменных окружения (копировать в .env, значения не коммитить)

# API-токен Cloudflare для wrangler (Pages + Workers + D1 + KV + Queues).
# Права: Workers Scripts edit, Pages write, D1 write, KV write, Queues write.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# JWT-секрет воркера. НЕ в git и НЕ в wrangler.toml [vars]:
#   cd worker && npx wrangler secret put JWT_SECRET
# Ротация: повторный secret put (инвалидирует выданные токены — пользователи перелогинятся).
JWT_SECRET=

# Allowlist CORS-origin фронтенда (comma-separated), см. ADR-012.
FRONTEND_ORIGIN=https://master.demo-fullstack-frontend.pages.dev,http://localhost:5173
