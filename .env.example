# Backend (эталонная реализация, Python + PostgreSQL + Celery)
DATABASE_URL=postgresql+asyncpg://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379/0
ENVIRONMENT=development
LOG_LEVEL=INFO
CACHE_TTL_SECONDS=60
RATE_LIMIT_PER_MINUTE=120
PROMETHEUS_ENABLED=true

# Celery (по умолчанию используется REDIS_URL)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Деплой на Cloudflare (только в CI/CD, не коммитить)
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# JWT secret (обязательно сменить в продакшене)
JWT_SECRET_KEY=your_jwt_secret_change_in_production