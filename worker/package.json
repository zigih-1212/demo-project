{
  "name": "demo-fullstack-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "wrangler d1 migrations apply demo-fullstack-db --local",
    "db:migrate": "wrangler d1 migrations apply demo-fullstack-db --remote",
    "db:seed": "wrangler d1 execute demo-fullstack-db --file=./src/db/seed.sql --remote"
  },
  "dependencies": {
    "hono": "^4.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241011.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.152.0"
  }
}